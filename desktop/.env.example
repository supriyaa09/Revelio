# Revelio Desktop — environment (all optional)
#
# Everything can also be set from the in-app Settings screen. Values set in the
# app take precedence over these variables.

# AI provider: "anthropic" (default) or "agentrouter"
REVELIO_AI_PROVIDER=

# Anthropic direct
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# REVELIO_ANTHROPIC_BASE_URL=

# AgentRouter (Anthropic-compatible gateway)
# REVELIO_AGENTROUTER_API_KEY=
# REVELIO_AGENTROUTER_MODEL=claude-opus-5
# REVELIO_AGENTROUTER_BASE_URL=https://agentrouter.org
# REVELIO_AGENTROUTER_USER_AGENT=
