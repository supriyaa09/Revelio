# Copy to .env (or .env.local) and fill in real values locally.
# Never commit a filled-in copy. Variable names only in this file.
# Delete the entries below that the chosen stack does not use, and add the ones it does.

# Supabase — client-side (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-side only. The service role key bypasses Row Level Security.
# Never expose it to the client and never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI — server-side only
GEMINI_API_KEY=
