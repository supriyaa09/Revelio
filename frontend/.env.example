# Copy to .env.local inside frontend/ and fill in real values.
# Never commit a filled-in copy.

# ── Supabase: client-side (safe to expose to the browser) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase: server-side only ─────────────────────────────────────────────
# NOT required by the application. Processing writes through SECURITY DEFINER
# RPCs, so no service-role key is needed and none is used at runtime. Set this
# only to run frontend/scripts/diagnose-upload.mjs, which mints a test session.
# It bypasses Row Level Security. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI: server-side only ───────────────────────────────────────────────────
# Anthropic Claude, used by the document-processing pipeline for summaries,
# key points, entities, dates and classification. NEVER prefix this with
# NEXT_PUBLIC_ — that would ship the key to every browser.
#
# A real Anthropic key starts with "sk-ant-". Anything else will be rejected
# with 401 and the pipeline will report API_ERROR.
#
# Without it the pipeline still extracts text, runs OCR, chunks and indexes,
# and classifies with the deterministic keyword matcher. It reports that no AI
# analysis exists rather than inventing one.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# ── Endpoint override: leave this alone unless you mean it ──────────────────
# The Anthropic SDK reads ANTHROPIC_BASE_URL from the environment by itself,
# and this process inherits your whole shell. A base URL exported for some
# unrelated tool would otherwise redirect every institutional document — full
# text of circulars, budgets, student records — to a third party.
#
# So ANTHROPIC_BASE_URL alone is IGNORED and logged. To actually route through
# a gateway or self-hosted proxy, set BOTH of these:
#
#   ANTHROPIC_BASE_URL=https://your-gateway.example.com
#   ANTHROPIC_ALLOW_BASE_URL_OVERRIDE=true
#
# Run `npm run probe:ai` to print the endpoint that will really be used.
