# Copy to .env.local inside frontend/ and fill in real values.
# Never commit a filled-in copy.

# ── Supabase: client-side (safe to expose to the browser) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase: server-side only ─────────────────────────────────────────────
# NOT required by the application. Processing writes through SECURITY DEFINER
# RPCs, so no service-role key is needed and none is used at runtime. Set this
# only to run frontend/scripts/diagnose-upload.mjs, which mints a test session.
# It bypasses Row Level Security. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI provider selection ──────────────────────────────────────────────────
# anthropic   (default) — calls api.anthropic.com with the Anthropic SDK.
# agentrouter          — calls an AgentRouter gateway that speaks the Anthropic
#                        Messages API. Use this to reuse an AgentRouter key.
# REVELIO_AI_PROVIDER=agentrouter

# ── AgentRouter settings (only read when REVELIO_AI_PROVIDER=agentrouter) ───
# Base URL. Default https://agentrouter.org — verified working.
#   NOTE: https://co.agentrouter.org is NOT a valid host for this. It answers,
#   but returns 401 {"code":401,"msg":"Invalid API Key!"} for every credential,
#   auth scheme and header combination tested. It looks like a bad key and is not.
# REVELIO_AGENTROUTER_BASE_URL=https://agentrouter.org
#
# Model. Default claude-opus-5. Availability is per-account: claude-sonnet-5
# returned 503 "no available channel" on the account this was built against.
# REVELIO_AGENTROUTER_MODEL=claude-opus-5
#
# Credential. Falls back to ANTHROPIC_API_KEY, then ANTHROPIC_AUTH_TOKEN, so an
# existing AgentRouter key already in one of those is picked up automatically.
# REVELIO_AGENTROUTER_API_KEY=
#
# Client identity. AgentRouter rejects requests whose User-Agent does not look
# like a Claude CLI client, with 401 "unauthorized client detected" — which is
# why routing a valid key through the Anthropic SDK fails while the same key
# works in Claude Code. Whether presenting this from a web server fits your
# AgentRouter agreement is a question about your account; set it to whatever
# that agreement permits.
# REVELIO_AGENTROUTER_USER_AGENT=claude-cli/2.1.239 (external, cli)

# ── AI: server-side only ───────────────────────────────────────────────────
# The API credential, used by whichever provider is selected. NEVER prefix this
# with NEXT_PUBLIC_ — that would ship the key to every browser.
#
# For the anthropic provider a real key starts with "sk-ant-". A gateway issues
# its own key format, so that prefix is only expected on the direct path.
#
# Without a credential the pipeline still extracts text, runs OCR, chunks and
# indexes, and classifies with the deterministic keyword matcher. It reports that
# no AI analysis exists rather than inventing one.
ANTHROPIC_API_KEY=

# Optional model override for the anthropic provider. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# ── Endpoint override for the anthropic provider ────────────────────────────
# Ignored entirely when REVELIO_AI_PROVIDER=agentrouter — that provider has its
# own REVELIO_AGENTROUTER_BASE_URL above.
#
# Two variables, in precedence order:
#
#   1. REVELIO_ANTHROPIC_BASE_URL  — wins outright, no second flag needed.
#   2. ANTHROPIC_BASE_URL          — needs ANTHROPIC_ALLOW_BASE_URL_OVERRIDE=true.
#
# Why they differ. The Anthropic SDK reads ANTHROPIC_BASE_URL from the
# environment by itself, and this process inherits your whole shell — so a value
# exported for some unrelated tool would silently redirect every institutional
# document (full text of circulars, budgets, student records) to a host nobody
# chose. That variable alone is therefore IGNORED and logged.
#
# REVELIO_-prefixed variables cannot arrive by accident: nothing outside this
# project sets them, so setting one already states the intent that the second
# flag exists to extract.
#
# Note that pointing this at a gateway is usually NOT enough on its own — the
# SDK sends its own User-Agent, which AgentRouter-style gateways reject. Use
# REVELIO_AI_PROVIDER=agentrouter for those instead.
#
# REVELIO_ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_ALLOW_BASE_URL_OVERRIDE=true
#
# Run `npm run probe:ai` to print the provider, endpoint, model and credential
# source that will really be used.
