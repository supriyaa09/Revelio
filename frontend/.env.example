# Copy to .env.local inside frontend/ and fill in real values.
# Never commit a filled-in copy.

# ── Supabase: client-side (safe to expose to the browser) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase: server-side only ─────────────────────────────────────────────
# The service-role key bypasses Row Level Security. It is used only by the
# document-processing pipeline. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI: server-side only (used from Phase 3 onward) ────────────────────────
GEMINI_API_KEY=
